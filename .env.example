OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite+aiosqlite:///./monster_jobs.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_OPENAI=true
ENABLE_OPENAI_ON_INGEST=false
PLAYWRIGHT_SLOW_MO_MS=0
PLAYWRIGHT_VISUAL_SCROLL_DEBUG=false
# CDP Chrome setup (Linux):
# 1) google-chrome --remote-debugging-port=9222 --user-data-dir=/tmp/chrome-monster-profile
# 2) Browse to monster.com in that window
# 3) Keep USE_CDP_CHROME=true below
USE_CDP_CHROME=true
CHROME_CDP_URL=http://localhost:9222
CHROME_USER_DATA_DIR=/tmp/chrome-monster-profile
# Monster.com is the only job source (Playwright). Set false only to fail searches without a browser.
ENABLE_MONSTER_PLAYWRIGHT=true
# Extra OpenAI call per job to blend into relevance_score (slower; costs tokens).
ENABLE_AI_RELEVANCE_SCORING=false
MAX_JOBS_PER_SEARCH=25
REQUEST_DELAY_MS=800
# Optional jitter bounds (milliseconds). Omit both to derive from REQUEST_DELAY_MS.
# SCRAPE_DELAY_MIN_MS=
# SCRAPE_DELAY_MAX_MS=
# Path to playwright storage state JSON if it exists (session cookies). Saves only if PLAYWRIGHT_SAVE_STORAGE_STATE=true.
# PLAYWRIGHT_STORAGE_STATE_PATH=./monster_playwright_state.json
PLAYWRIGHT_SAVE_STORAGE_STATE=false
# Seconds; identical completed searches can copy rows without scraping. 0 = always live scrape (default).
SEARCH_CACHE_TTL_SECONDS=0
# Shared query feed (title + location). Fresh rows skip listing scrape; stale rows return immediately + background refresh.
QUERY_FEED_CACHE_TTL_SECONDS=1800
INGEST_RATE_LIMIT_SECONDS=1800
# Background asyncio ticker interval (seconds) for refreshing known feeds. 0 disables it.
INGESTION_SCHEDULE_SECONDS=2700
INGEST_MAX_PAGES=2
INGEST_MAX_JOBS=15
INGEST_HUMAN_DELAY_MIN_S=2.0
INGEST_HUMAN_DELAY_MAX_S=5.0
POST_NAV_WAIT_MS=2000
MONSTER_SCRAPE_RETRIES=2
MONSTER_RETRY_BACKOFF_SECONDS=5,15
# Optional persistent Chromium profile path (created if missing).
PLAYWRIGHT_USER_DATA_DIR=
